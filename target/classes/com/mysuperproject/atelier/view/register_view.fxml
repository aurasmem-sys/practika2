<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="550.0" prefWidth="350.0" spacing="15.0" style="-fx-background-color: -color-bg-default;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mysuperproject.atelier.view.RegisterController">
    <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="20.0" />
    </padding>

    <HBox alignment="TOP_RIGHT">
        <children>
            <Button mnemonicParsing="false" onAction="#onToggleTheme" styleClass="button-outlined" text="Змінити тему" />
        </children>
    </HBox>

    <children>
        <Label style="-fx-text-fill: -color-fg-default;" text="Реєстрація">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
        </Label>
        
        <VBox fx:id="registerFormBox" spacing="10.0">
            <children>
                <VBox spacing="5.0">
                    <children>
                        <Label style="-fx-text-fill: -color-fg-default;" text="Ім'я" />
                        <TextField fx:id="firstNameField" promptText="введіть ім'я" />
                    </children>
                </VBox>
                <VBox spacing="5.0">
                    <children>
                        <Label style="-fx-text-fill: -color-fg-default;" text="Прізвище" />
                        <TextField fx:id="lastNameField" promptText="введіть прізвище" />
                    </children>
                </VBox>
                <VBox spacing="5.0">
                    <children>
                        <Label style="-fx-text-fill: -color-fg-default;" text="Телефон" />
                        <TextField fx:id="phoneField" promptText="введіть номер телефону" />
                    </children>
                </VBox>
                <VBox spacing="5.0">
                    <children>
                        <Label style="-fx-text-fill: -color-fg-default;" text="Email (обов'язково)" />
                        <TextField fx:id="emailField" promptText="введіть email..." />
                    </children>
                </VBox>
                <VBox spacing="5.0">
                    <children>
                        <Label style="-fx-text-fill: -color-fg-default;" text="Пароль" />
                        <PasswordField fx:id="passwordField" promptText="введіть пароль..." />
                    </children>
                </VBox>
            </children>
        </VBox>

        <VBox fx:id="verificationBox" spacing="10.0" visible="false" managed="false">
            <children>
                <Label style="-fx-text-fill: -color-success-fg;" text="Код надіслано на вашу пошту!" />
                <TextField fx:id="codeField" promptText="Введіть 6-значний код" styleClass="large" />
                <Button fx:id="verifyButton" maxWidth="Infinity" mnemonicParsing="false" onAction="#onVerify" styleClass="accent" text="Підтвердити" />
            </children>
        </VBox>

        <Label fx:id="errorLabel" style="-fx-text-fill: -color-danger-fg;" wrapText="true" />
        
        <Button fx:id="registerButton" defaultButton="true" maxWidth="Infinity" mnemonicParsing="false" onAction="#onRegister" styleClass="accent" text="Зареєструватися" />
        <Button fx:id="backButton" maxWidth="Infinity" mnemonicParsing="false" onAction="#onBack" styleClass="flat" text="Назад до входу" />
    </children>
</VBox>
