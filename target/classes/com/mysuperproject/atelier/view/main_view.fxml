<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mysuperproject.atelier.view.ClientsController">
   <children>
      <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
        <tabs>
          <Tab text="Клієнти (CRUD + Пошук)">
               <content>
                  <VBox spacing="10.0">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <Label text="Пошук клієнта:" />
                              <TextField fx:id="searchField" promptText="Введіть ім'я, прізвище, email..." HBox.hgrow="ALWAYS" />
                           </children>
                           <padding>
                              <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                           </padding>
                        </HBox>
                        <TableView fx:id="clientsTable" VBox.vgrow="ALWAYS">
                          <columns>
                            <TableColumn fx:id="idCol" prefWidth="50.0" text="ID" />
                            <TableColumn fx:id="firstNameCol" prefWidth="150.0" text="Ім'я" />
                              <TableColumn fx:id="lastNameCol" prefWidth="150.0" text="Прізвище" />
                              <TableColumn fx:id="phoneCol" prefWidth="150.0" text="Телефон" />
                              <TableColumn fx:id="emailCol" prefWidth="200.0" text="Email" />
                          </columns>
                        </TableView>
                        <HBox spacing="10.0">
                           <children>
                              <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <TextField fx:id="firstNameField" promptText="Ім'я" />
                                    <TextField fx:id="lastNameField" promptText="Прізвище" />
                                 </children>
                              </VBox>
                              <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <TextField fx:id="phoneField" promptText="Телефон" />
                                    <TextField fx:id="emailField" promptText="Email" />
                                 </children>
                              </VBox>
                              <VBox alignment="TOP_CENTER" spacing="5.0">
                                 <children>
                                    <Button fx:id="addButton" mnemonicParsing="false" onAction="#onAdd" prefWidth="100.0" text="Додати" />
                                    <Button fx:id="updateButton" mnemonicParsing="false" onAction="#onUpdate" prefWidth="100.0" text="Оновити" />
                                    <Button fx:id="deleteButton" mnemonicParsing="false" onAction="#onDelete" prefWidth="100.0" text="Видалити" style="-fx-text-fill: red;" />
                                 </children>
                              </VBox>
                           </children>
                           <padding>
                              <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                           </padding>
                        </HBox>
                     </children>
                     <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </padding>
                  </VBox>
               </content>
          </Tab>
          <Tab text="Замовлення (Демо)">
            <content>
              <VBox alignment="CENTER" spacing="10.0">
                  <Label text="Тут має бути інтерфейс замовлень." />
                  <Label text="Він будується аналогічно до вкладки Клієнти (за патерном MVVM)." />
              </VBox>
            </content>
          </Tab>
        </tabs>
      </TabPane>
   </children>
</VBox>
